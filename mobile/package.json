{
  "name": "mobile-e2e-mydemoapp",
  "version": "1.0.0",
  "private": true,
  "description": "Android E2E automation for Sauce Labs My Demo App - Appium + WebdriverIO + TypeScript",
  "scripts": {
    "appium": "appium --allow-cors --relaxed-security",
    "test": "wdio run ./config/wdio.android.local.conf.ts",
    "test:smoke": "wdio run ./config/wdio.android.local.conf.ts --mochaOpts.grep @smoke",
    "test:regression": "wdio run ./config/wdio.android.local.conf.ts --mochaOpts.grep @regression",
    "test:cloud": "wdio run ./config/wdio.android.cloud.conf.ts",
    "typecheck": "tsc --noEmit",
    "report": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wdio/allure-reporter": "^9.4.0",
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/spec-reporter": "^9.4.0",
    "appium": "^2.12.0",
    "appium-uiautomator2-driver": "^3.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
